{
  "installCommand": "pnpm install --frozen-lockfile && pnpm --dir sanity-studio install --ignore-workspace --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "headers": [
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
