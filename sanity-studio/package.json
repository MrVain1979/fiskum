{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "format": "prettier --write .",
    "start": "sanity start",
    "lint": "eslint .",
    "build": "sanity build ../apps/studio/studio",
    "build:root": "sanity build ../studio",
    "deploy": "sanity deploy",
    "type": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "check-types": "tsc --noEmit",
    "postinstall": "sanity exec scripts/cli-alert-for-data.ts"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/assist": "6.2.6",
    "@sanity/icons": "^3.7.4",
    "@sanity/orderable-document-list": "2.0.28",
    "@sanity/preview-url-secret": "2.1.16",
    "@sanity/ui": "4.4.10",
    "@sanity/vision": "6.14.1",
    "lucide-react": "^0.522.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sanity": "6.14.1",
    "sanity-plugin-asset-source-unsplash": "7.0.30",
    "sanity-plugin-media": "6.6.0",
    "slugify": "^1.6.6",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@portabletext/block-tools": "^1.1.31",
    "@sanity/eslint-config-studio": "^5.0.2",
    "@sanity/schema": "6.14.1",
    "@supercharge/promise-pool": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3"
  }
}
